{
	"name": "web-game-mother-hub",
	"version": "0.1.0",
	"type": "module",
	"exports": {
		"./package.json": "./package.json",
		".": "./server/index.js"
	},
	"description": "Run, update, reset and share the house's web games from one page",
	"author": "justfatlard",
	"license": "MIT",
	"browserslist": [
		"last 1 version",
		"> 1%",
		"not dead",
		"not op_mini all"
	],
	"scripts": {
		"prepare": "bun run prepare:githooks && bun run build",
		"prepare:githooks": "[ -n \"$CI\" ] && exit 0 || (git config --local core.hooksPath .githooks || echo 'Cannot set core.hooksPath -- push checks will not run')",
		"build": "bun run build:clean && vbc-build",
		"build:clean": "rm -rf ./client/build/",
		"start": "NODE_ENV=production bun server/index.js",
		"dev": "NODE_ENV=development bun --hot server/index.js",
		"test": "bun test",
		"lint": "bun --bun eslint",
		"lint:fix": "bun --bun eslint --fix",
		"format": "bun run lint:fix && bun --bun prettier --write .",
		"deploy": "bun run build && systemctl --user restart bun-server@web-game-mother-hub"
	},
	"dependencies": {
		"@vanilla-bean/components": "^7.3.0",
		"argi-cli": "^1.0.0",
		"lowdb": "^7.0.1",
		"marked": "^18.0.6"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"bun-types": "^1.3.14",
		"eslint": "^10.7.0",
		"eslint-plugin-compat": "^7.0.2",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsdoc": "^63.0.13",
		"eslint-plugin-spellcheck": "0.0.20",
		"eslint-plugin-write-good-comments": "^0.2.0",
		"globals": "^17.7.0",
		"prettier": "3.6.2"
	}
}
